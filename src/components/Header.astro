---
import Hamburger from "./Hamburger.astro";
import DesktopNavigation from "./DesktopNavigation.astro";
import MobileNavigation from "./MobileNavigation.astro";
import ThemeIcon from "./ThemeIcon.astro";
---

<header
  class='sticky top-0 z-50 h-16 w-full ml-auto backdrop-blur-sm border-b border-gray-200 dark:border-gray-700'
>
  <nav
    class='relative mx-auto flex h-full w-full max-w-[80ch] items-center justify-between px-6'
  >
    <a
      href='/'
      class='text-lg font-bold cursor-pointer no-underline hover:text-oscarPink focus:text-oscarPink'
      aria-current={Astro.url.pathname === "/" ? "page" : undefined}
    >
      Oscar Torres
    </a>
    <div class='hidden items-center gap-6 sm:flex'>
      <DesktopNavigation />
      <ThemeIcon />
    </div>
    <Hamburger />
    <MobileNavigation />
  </nav>
</header>
