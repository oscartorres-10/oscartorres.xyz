---
import { Icon } from "astro-icon/components";
---

<button
  class='hamburger ml-auto cursor-pointer text-oscarPink sm:hidden'
  type='button'
  aria-label='Open menu'
  aria-expanded='false'
  aria-controls='mobile-navigation'
>
  <Icon name='lucide:menu' class='h-8 w-8' />
  <Icon name='lucide:x' class='hidden h-8 w-8' />
</button>
