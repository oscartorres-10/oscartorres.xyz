---
import { Image } from "astro:assets";
import Artifacts from "../components/Artifacts.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Skills from "../components/Skills.astro";
import "../styles/global.css";
const pageTitle = `Hey! I'm Oscar`;
import profile from "../assets/profile.jpg";
---

<BaseLayout pageTitle={pageTitle} lang='en-US'>
  <section
    class='mx-auto flex max-w-230 flex-col items-center text-center'
  >
    <Image
      src={profile}
      class='my-4 w-64 rounded-full border-2 border-gray-200'
      alt='Oscar Torres'
    />
    <Artifacts />
    <article>
      <h1 id='title' class='my-4 text-2xl'>Hey! I’m Oscar.</h1>
      <p class='mb-4 text-[0.8em]'>
        I am a Senior Frontend Engineer with 5+ years of experience specialized
        in building UIs with TypeScript and React. At dLocal, a fintech platform
        processing $41B for the world biggest brands, I led the launch of a new
        Home page to track key payment metrics for 760+ B2B customers.
      </p>
      <p class='mb-4 text-[0.8em]'>
        <strong>🚀 My personal motto: </strong><i
          >"No person is more important than The Team"</i
        >
      </p>

      <hr class='border-gray-200 dark:border-gray-700' />

      <Skills />
      <a
        href='https://www.linkedin.com/in/oscartorres10/'
        class='text-[1em] font-normal text-[#3498db] hover:text-oscarPink underline'
        target='_blank'>Let’s connect!</a
      >
    </article>
  </section>
</BaseLayout>
